#if UNITY_EDITOR
using UnityEditor;
using UnityEditor.Callbacks;
using UnityEngine;

// Auto-run the ApplyAttackHitPresets tool for GameObject named "AnimManager" once after compilation/editor loads.
[InitializeOnLoad]
public static class AutoRunApply
{
    static AutoRunApply()
    {
        // schedule on next editor update (after compilation)
        EditorApplication.delayCall += RunOnce;
    }

    static void RunOnce()
    {
        EditorApplication.delayCall -= RunOnce;
        // find AnimationController components in open scenes
        var comps = UnityEngine.Object.FindObjectsOfType<global::AnimationController>();
        if (comps == null || comps.Length == 0)
        {
            Debug.LogWarning("AutoRunApply: No AnimationController components found in loaded scenes.");
            return;
        }

        foreach (var c in comps)
        {
            if (c == null) continue;
            if (c.gameObject.name == "AnimManager")
            {
                Selection.activeGameObject = c.gameObject;
                bool ok = EditorApplication.ExecuteMenuItem("Tools/Animator/AutoApply Attack-Hit Presets To Selected AnimationController");
                Debug.Log($"AutoRunApply: Executed AutoApply on '{c.gameObject.name}' -> success={ok}");
                return;
            }
        }

        Debug.LogWarning("AutoRunApply: GameObject named 'AnimManager' not found in loaded scenes.");
    }
}
#endif
