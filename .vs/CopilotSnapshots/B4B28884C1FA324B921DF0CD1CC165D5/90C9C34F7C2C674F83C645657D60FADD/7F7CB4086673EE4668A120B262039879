using UnityEngine;
/// <summary>
/// PROJECT ARCHITECTURE: Core Logic Layer (Controller trung tâm)
/// ROLE: Điều phối luồng trận đấu, nhận dữ liệu từ WebSocketManager và phân phối xuống các hệ thống UI/Animation.
/// RESPONSIBILITIES:
/// - Lưu trữ trạng thái trận đấu hiện tại (MatchState) theo tài liệu thiết kế.
/// - Phân tích (Parse) các gói tin JSON từ Server thành các C# Object tương ứng.
/// - Gọi các hàm cập nhật giao diện của PlayerUI, RoundManager và AnimationController khi có sự kiện mới.
/// AI NOTE: Script này đóng vai trò bộ não trung tâm của Client, không tự tính toán sát thương (vì BE đã tính), chỉ nhận kết quả và điều phối hiển thị.
/// </summary>
using System;
using System.Reflection;
using UnityEngine;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;

public class GameManager : MonoBehaviour
{
    public static GameManager Instance { get; private set; }
    // Tham chiếu đến các quản lý thành phần khác trong scene
    public PlayerUI playerUI;
    public RoundManager roundManager;
    public AnimationController animationController;
    [Header("Local Test")]
    public bool enableLocalInputTesting = true;
    [Header("Auto Subscribe")]
    [Tooltip("If set, GameManager will subscribe to this matchId when WebSocket is connected")]
    public string initialMatchId = "";

    void Start()
    {
        Instance = this;

        if (WebSocketManager.Instance != null)
        {
            WebSocketManager.Instance.OnRawMessageReceived += HandleRawMessage;
            // auto-subscribe if initialMatchId provided
            if (!string.IsNullOrEmpty(initialMatchId))
            {
                if (WebSocketManager.Instance != null && WebSocketManager.Instance.IsConnected())
                {
                    _ = WebSocketManager.Instance.SubscribeToMatch(initialMatchId, 0);
                }

    public void ApplyRawMessage(string json)
    {
        HandleRawMessage(json);
    }
                else
                {
                    // wait for connection progress
                    WebSocketManager.Instance.OnConnectionProgress += WaitAndSubscribe;
                }
            }
        }
    }

    void WaitAndSubscribe(float p, string status)
    {
        if (p >= 1f)
        {
            if (!string.IsNullOrEmpty(initialMatchId))
            {
                _ = WebSocketManager.Instance.SubscribeToMatch(initialMatchId, 0);
            }
            WebSocketManager.Instance.OnConnectionProgress -= WaitAndSubscribe;
        }
    }

    // store latest max HP per character id from snapshot
    private System.Collections.Generic.Dictionary<string, long> _characterMaxHp = new System.Collections.Generic.Dictionary<string, long>();
    private MemeBattleMatchSnapshot _latestSnapshot;

    // Debug helpers callable from editor buttons
    public void DebugTriggerQ()
    {
        var p = GetRandomPreset();
        if (p != null)
        {
            Debug.Log($"[DebugTrigger] Q -> Play preset '{p.key}' (Left attacks)");
            PlayBothAnimations(p.leftState, p.rightState);
        }
        else Debug.LogWarning("[DebugTrigger] Q -> no valid presets");
    }

    public void DebugTriggerE()
    {
        var p = GetRandomPreset();
        if (p != null)
        {
            Debug.Log($"[DebugTrigger] E -> Play preset '{p.key}' (Right attacks)");
            PlayBothAnimations(p.rightState, p.leftState);
        }
        else Debug.LogWarning("[DebugTrigger] E -> no valid presets");
    }

    void Update()
    {
        if (!enableLocalInputTesting) return;
        // Quick local testing:
        // Q -> randomly pick a preset, left attacks / right hit
        if (IsKeyDown(KeyCode.Q))
        {
            var p = GetRandomPreset();
            if (p != null)
            {
                Debug.Log($"[LocalTest] Q pressed -> Play preset '{p.key}' (Left attacks)");
                PlayBothAnimations(p.leftState, p.rightState);
            }
            else
            {
                Debug.LogWarning("[LocalTest] Q pressed but no valid animation presets available.");
            }
        }

        // E -> randomly pick a preset, RIGHT attacks / LEFT hit (reverse sides)
        if (IsKeyDown(KeyCode.E))
        {
            var p = GetRandomPreset();
            if (p != null)
            {
                Debug.Log($"[LocalTest] E pressed -> Play preset '{p.key}' (Right attacks)");
                // reverse: left should play the victim/hit (p.rightState), right should play attacker (p.leftState)
                PlayBothAnimations(p.rightState, p.leftState);
            }
            else
            {
                Debug.LogWarning("[LocalTest] E pressed but no valid animation presets available.");
            }
        }
    }

    void OnDestroy()
    {
        if (WebSocketManager.Instance != null)
        {
            WebSocketManager.Instance.OnRawMessageReceived -= HandleRawMessage;
        }
    }

    // Input system detection: support both legacy Input and the new Input System package.
    private bool _inputChecked = false;
    private bool _useNewInputSystem = false;
    // reflection cache for Input System types/properties
    private Type _keyboardType;
    private PropertyInfo _keyboardCurrentProp;
    private PropertyInfo _keyQProp;
    private PropertyInfo _keyEProp;
    private PropertyInfo _wasPressedProp;

    bool IsKeyDown(KeyCode key)
    {
        if (!_inputChecked)
        {
            try
            {
                // Try legacy Input once; if it throws, fall back to new Input System
                bool v = Input.GetKeyDown(key);
                _useNewInputSystem = false;
                _inputChecked = true;
                Debug.Log("GameManager: Input system check - using legacy Input");
                return v;
            }
            catch (System.InvalidOperationException)
            {
                _useNewInputSystem = true;
                _inputChecked = true;
                Debug.Log("GameManager: Input system check - legacy Input threw, falling back to new Input System (reflection)");
            }
        }

        if (_useNewInputSystem)
        {
            try
            {
                // lazy initialize reflection info
                if (_keyboardType == null)
                {
                    _keyboardType = Type.GetType("UnityEngine.InputSystem.Keyboard, Unity.InputSystem")
                                    ?? Type.GetType("UnityEngine.InputSystem.Keyboard, UnityEngine.InputSystem");
                    if (_keyboardType != null)
                    {
                        _keyboardCurrentProp = _keyboardType.GetProperty("current", BindingFlags.Public | BindingFlags.Static);
                        _keyQProp = _keyboardType.GetProperty("qKey");
                        _keyEProp = _keyboardType.GetProperty("eKey");
                        // KeyControl type for wasPressedThisFrame
                        var keyControlType = Type.GetType("UnityEngine.InputSystem.Controls.KeyControl, Unity.InputSystem")
                                         ?? Type.GetType("UnityEngine.InputSystem.Controls.KeyControl, UnityEngine.InputSystem");
                        if (keyControlType != null)
                        {
                            _wasPressedProp = keyControlType.GetProperty("wasPressedThisFrame", BindingFlags.Public | BindingFlags.Instance);
                        }
                    }
                }

                if (_keyboardType == null || _keyboardCurrentProp == null) return false;
                var current = _keyboardCurrentProp.GetValue(null);
                if (current == null) return false;

                PropertyInfo keyProp = null;
                if (key == KeyCode.Q) keyProp = _keyQProp;
                else if (key == KeyCode.E) keyProp = _keyEProp;
                else return false; // only support Q/E for now

                if (keyProp == null) return false;
                var keyControl = keyProp.GetValue(current);
                if (keyControl == null || _wasPressedProp == null) return false;
                var val = _wasPressedProp.GetValue(keyControl);
                return val is bool b && b;
            }
            catch
            {
                Debug.LogWarning("GameManager: Reflection-based input check failed.");
                return false;
            }
        }

        // Legacy
        return Input.GetKeyDown(key);
    }

    void HandleRawMessage(string json)
    {
        if (string.IsNullOrEmpty(json)) return;

        try
        {
            var j = JObject.Parse(json);
            var type = j.Value<string>("type");
            if (!string.IsNullOrEmpty(type))
            {
                switch (type)
                {
                    case "meme_battle_snapshot":
                        {
                            var snap = j["snapshot"].ToObject<MemeBattleMatchSnapshot>();
                            if (snap != null)
                            {
                                _latestSnapshot = snap;
                                // store max HP map
                                _characterMaxHp = snap.characterMaxHpAtomic ?? new System.Collections.Generic.Dictionary<string, long>();

                                // update UI for known bots
                                if (snap.characterHpAtomic != null)
                                {
                                    UpdatePlayerHpFromSnapshot("bot_a", PlayerUI.Side.Left, snap);
                                    UpdatePlayerHpFromSnapshot("bot_b", PlayerUI.Side.Right, snap);
                                }
                                // optionally notify round manager about turn state
                                if (snap.currentTurn != null)
                                {
                                    // start timer using opensAt/closesAt provided in turn
                                    roundManager?.StartTurnTimer(snap.currentTurn.turnNumber, snap.currentTurn.opensAt, snap.currentTurn.closesAt);
                                }
                            }
                            break;
                        }

                    case "meme_battle_event":
                        {
                            var ev = j["event"].ToObject<MemeBattleEvent>();
                            if (ev != null)
                            {
                                HandleMemeBattleEvent(ev);
                            }
                            break;
                        }
                    case "error":
                        {
                            var err = j.Value<string>("error");
                            Debug.LogError($"GameManager: socket error: {err}");
                            break;
                        }
                    default:
                        break;
                }
                return;
            }
        }
        catch (Exception)
        {
            // not a structured socket message; fall back to legacy parsing below
        }

        // Legacy fallback: try previous simple event parsing
        string evtName = ExtractEventName(json);
        switch (evtName)
        {
            case "playerLeftAttack":
                {
                    int dmg = ExtractInt(json, "damage");
                    PlaySingleAnimation(PlayerUI.Side.Left, "LeftAttack");
                    playerUI?.ShowDamage(PlayerUI.Side.Left, dmg);
                    break;
                }
            case "playerRightHit":
                {
                    int dmg = ExtractInt(json, "damage");
                    PlaySingleAnimation(PlayerUI.Side.Right, "RightHit");
                    playerUI?.ShowDamage(PlayerUI.Side.Right, dmg);
                    break;
                }
            case "playerLeftAnswer":
                {
                    string text = ExtractString(json, "answer") ?? ExtractString(json, "text");
                    playerUI?.SetDialogue(PlayerUI.Side.Left, text);
                    PlaySingleAnimation(PlayerUI.Side.Left, "Talk");
                    break;
                }
            case "ShowQuestion":
            case "question_start":
                {
                    string q = ExtractString(json, "question") ?? ExtractString(json, "text");
                    roundManager?.ShowQuestion(q);
                    break;
                }
            default:
                break;
        }
    }

    void UpdatePlayerHpFromSnapshot(string characterId, PlayerUI.Side side, MemeBattleMatchSnapshot snap)
    {
        if (snap.characterHpAtomic != null && snap.characterHpAtomic.TryGetValue(characterId, out long hp))
        {
            long max = 0;
            if (snap.characterMaxHpAtomic != null) snap.characterMaxHpAtomic.TryGetValue(characterId, out max);
            playerUI?.UpdateFromState(side, (float)hp, (float)max, 0f, 1f, characterId);
        }
    }

    void HandleMemeBattleEvent(MemeBattleEvent ev)
    {
        var t = ev.eventType;
        var payload = ev.payload;
        switch (t)
        {
            case "MATCH_STARTED":
                {
                    bool open = payload.Value<bool?>("contributionWindowOpen") ?? false;
                    Debug.Log($"MATCH_STARTED contributionWindowOpen={open}");
                    break;
                }
            case "TURN_STARTED":
                {
                    int turnNumber = payload.Value<int?>("turnNumber") ?? 0;
                    roundManager?.ShowQuestion($"Turn {turnNumber}");
                    break;
                }
            case "ARGUMENT_SELECTED":
                {
                    string animationId = payload.Value<string>("animationId");
                    string argumentId = payload.Value<string>("argumentId");
                    // Try to find the argument in the latest snapshot to infer attacker/target
                    Argument arg = null;
                    if (_latestSnapshot != null && _latestSnapshot.currentTurn != null && _latestSnapshot.currentTurn.arguments != null)
                    {
                        arg = _latestSnapshot.currentTurn.arguments.Find(a => string.Equals(a.argumentId, argumentId, StringComparison.OrdinalIgnoreCase));
                    }

                    string animToPlay = animationId;
                    string targetCharacterId = null;
                    if (arg != null)
                    {
                        animToPlay = string.IsNullOrEmpty(animationId) ? arg.animationId : animationId;
                        targetCharacterId = arg.targetCharacterId;
                    }

                    if (!string.IsNullOrEmpty(animToPlay))
                    {
                        // heuristics: if animationId contains 'bot_a' or target is bot_b then attacker is bot_a (Left)
                        PlayerUI.Side? attackerSide = null;
                        if (animToPlay.IndexOf("bot_a", StringComparison.OrdinalIgnoreCase) >= 0 || string.Equals(targetCharacterId, "bot_b", StringComparison.OrdinalIgnoreCase)) attackerSide = PlayerUI.Side.Left;
                        else if (animToPlay.IndexOf("bot_b", StringComparison.OrdinalIgnoreCase) >= 0 || string.Equals(targetCharacterId, "bot_a", StringComparison.OrdinalIgnoreCase)) attackerSide = PlayerUI.Side.Right;
                        else attackerSide = null;

                        if (attackerSide.HasValue)
                        {
                            animationController?.PlayAnimation(attackerSide.Value, animToPlay);
                        }
                        else
                        {
                            // fallback: play on both
                            animationController?.PlayBoth(animToPlay, animToPlay);
                        }
                    }
                    break;
                }
            case "MULTIPLIER_SELECTED":
                {
                    int multiplierScaled = payload.Value<int?>("multiplierScaled") ?? 0;
                    int multiplierScale = payload.Value<int?>("multiplierScale") ?? 1;
                    Debug.Log($"Multiplier selected: {multiplierScaled}/{multiplierScale}");
                    break;
                }
            case "DAMAGE_APPLIED":
                {
                    string targetId = payload.Value<string>("targetCharacterId");
                    long damage = payload.Value<long?>("damageAtomic") ?? 0;
                    long hpAfter = payload.Value<long?>("hpAfterAtomic") ?? 0;
                    string animationId = payload.Value<string>("animationId");
                    var side = SideFromCharacterId(targetId);
                    if (side.HasValue)
                    {
                        playerUI?.ShowDamage(side.Value, (int)damage);
                        long max = 0;
                        _characterMaxHp?.TryGetValue(targetId, out max);
                        playerUI?.UpdateHP(side.Value, (float)hpAfter, (float)max);
                        if (!string.IsNullOrEmpty(animationId)) animationController?.PlayAnimation(side.Value, animationId);
                    }
                    break;
                }
            case "HP_CHANGED":
                {
                    string characterId = payload.Value<string>("characterId");
                    long hpAfter = payload.Value<long?>("hpAfterAtomic") ?? 0;
                    var side = SideFromCharacterId(characterId);
                    if (side.HasValue)
                    {
                        long max = 0;
                        _characterMaxHp?.TryGetValue(characterId, out max);
                        playerUI?.UpdateHP(side.Value, (float)hpAfter, (float)max);
                    }
                    break;
                }
            case "SKILL_ACTIVATED":
                {
                    string animationId = payload.Value<string>("skillId") ?? payload.Value<string>("animationId");
                    string source = payload.Value<string>("sourceCharacterId");
                    var side = SideFromCharacterId(source);
                    if (side.HasValue && !string.IsNullOrEmpty(animationId)) animationController?.PlaySkillVFX(side.Value, animationId);
                    break;
                }
            case "MATCH_FINISHING":
                {
                    Debug.Log("Match finishing");
                    break;
                }
            case "WINNER_DECLARED":
                {
                    string winner = payload.Value<string>("winnerCharacterId");
                    Debug.Log($"Winner: {winner}");
                    if (winner == "DRAW")
                    {
                        // show draw animation
                    }
                    else
                    {
                        var side = SideFromCharacterId(winner);
                        if (side.HasValue) animationController?.PlayPairSingle(side.Value, "Victory");
                    }
                    break;
                }
            case "MATCH_CANCELLED":
                {
                    Debug.Log("Match cancelled");
                    break;
                }
            default:
                Debug.Log($"Unhandled meme_battle_event: {t}");
                break;
        }
    }

    PlayerUI.Side? SideFromCharacterId(string id)
    {
        if (string.IsNullOrEmpty(id)) return null;
        if (id.Equals("bot_a", StringComparison.OrdinalIgnoreCase)) return PlayerUI.Side.Left;
        if (id.Equals("bot_b", StringComparison.OrdinalIgnoreCase)) return PlayerUI.Side.Right;
        return null;
    }

    // Helper: play an animation on one side via the AnimationController
    public void PlaySingleAnimation(PlayerUI.Side side, string animationId, float crossFade = -1f)
    {
        Debug.Log($"GameManager: PlaySingleAnimation side={side} animationId={animationId} crossFade={crossFade}");
        animationController?.PlayAnimation(side, animationId, crossFade);
    }

    // Helper: play animations for both sides at once
    public void PlayBothAnimations(string leftAnimationId, string rightAnimationId, float crossFade = -1f)
    {
        Debug.Log($"GameManager: PlayBothAnimations left={leftAnimationId} right={rightAnimationId} crossFade={crossFade}");
        animationController?.PlayBoth(leftAnimationId, rightAnimationId, crossFade);
    }

    // Return a random preset pair that has both left and right states defined
    AnimationController.AnimationPair GetRandomPreset()
    {
        if (animationController == null || animationController.presets == null || animationController.presets.Length == 0)
        {
            Debug.LogWarning($"GetRandomPreset: no animationController or presets. animationController={(animationController==null?"null":"set")}, presetsCount={(animationController?.presets==null?0:animationController.presets.Length)}");
            return null;
        }

        var valid = new System.Collections.Generic.List<AnimationController.AnimationPair>();
        foreach (var p in animationController.presets)
        {
            if (p == null) continue;
            if (string.IsNullOrEmpty(p.leftState) || string.IsNullOrEmpty(p.rightState))
            {
                Debug.Log($"GetRandomPreset: skipping preset '{p.key ?? "<null>"}' left='{p.leftState}' right='{p.rightState}' (incomplete pair)");
                continue;
            }
            valid.Add(p);
        }

        if (valid.Count == 0) return null;
        int idx = UnityEngine.Random.Range(0, valid.Count);
        return valid[idx];
    }

    string ExtractEventName(string json)
    {
        string[] keys = new[] { "event", "type", "action" };
        foreach (var k in keys)
        {
            var v = ExtractString(json, k);
            if (!string.IsNullOrEmpty(v)) return v;
        }
        return null;
    }

    string ExtractString(string json, string key)
    {
        if (string.IsNullOrEmpty(json) || string.IsNullOrEmpty(key)) return null;
        string pattern = '"' + key + '"' + ":";
        int idx = json.IndexOf(pattern);
        if (idx < 0) return null;
        idx += pattern.Length;
        // skip spaces
        while (idx < json.Length && char.IsWhiteSpace(json[idx])) idx++;
        if (idx >= json.Length) return null;
        if (json[idx] == '"')
        {
            idx++;
            int end = idx;
            while (end < json.Length)
            {
                if (json[end] == '\\') { end += 2; continue; }
                if (json[end] == '"') break;
                end++;
            }
            if (end >= json.Length) return null;
            return json.Substring(idx, end - idx);
        }
        return null;
    }

    int ExtractInt(string json, string key)
    {
        if (string.IsNullOrEmpty(json) || string.IsNullOrEmpty(key)) return 0;
        string pattern = '"' + key + '"' + ":";
        int idx = json.IndexOf(pattern);
        if (idx < 0) return 0;
        idx += pattern.Length;
        while (idx < json.Length && (char.IsWhiteSpace(json[idx]) || json[idx] == '"')) idx++;
        int end = idx;
        while (end < json.Length && (char.IsDigit(json[end]) || json[end] == '-')) end++;
        if (end <= idx) return 0;
        if (int.TryParse(json.Substring(idx, end - idx), out int v)) return v;
        return 0;
    }
}
