# This .gitignore file should be placed at the root of your Unity project directory
# https://github.com/github/gitignore/blob/main/Unity.gitignore

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]oops/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive and contain sensitive data
/[Mm]emoryCaptures/

# Asset meta data should only be ignored for temporal/generated assets
/[Aa]ssets/AssetStoreTools*

# Autogenerated Visual Studio / VS Code files
/[Cc]sPrj/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Autogenerated Rider files
*.sln.iml

# Unity 3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity 3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata*/*.bin*

# Temporary auto-generated AssetBundles
/[Aa]ssets/[Aa]ssetBundles/[Aa]ssetBundles
/[Aa]ssets/[Aa]ssetBundles/*.manifest

# MacOS Spotlight and Safari files
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
propertyPath
.Trash
*~